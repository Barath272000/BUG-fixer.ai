{
  "name": "Bug-fixer-fastapi",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "forwardPorts": [3000, 4000, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "Frontend (Vite)", "visibility": "public", "onAutoForward": "notify" },
    "4000": { "label": "Backend API (FastAPI)", "visibility": "public", "onAutoForward": "notify" },
    "5432": { "label": "Postgres", "visibility": "private" },
    "6379": { "label": "Redis", "visibility": "private" }
  },
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=SYS_ADMIN",
    "--cap-add=NET_ADMIN",
    "--device=/dev/fuse",
    "--device=/dev/net/tun"
  ],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y podman uidmap slirp4netns fuse-overlayfs && pip install -r backend/requirements.txt && cd frontend && npm install"
}
