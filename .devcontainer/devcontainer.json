{
  "name": "Bug-fixer-fastapi",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [3000, 4000, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "Frontend (Vite)", "visibility": "public", "onAutoForward": "notify" },
    "4000": { "label": "Backend API (FastAPI)", "visibility": "public", "onAutoForward": "notify" },
    "5432": { "label": "Postgres", "visibility": "private" },
    "6379": { "label": "Redis", "visibility": "private" }
  },
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=SYS_ADMIN",
    "--cap-add=NET_ADMIN",
    "--device=/dev/fuse",
    "--device=/dev/net/tun"
  ],
  "postCreateCommand": "bash .devcontainer/setup-podman.sh"
}