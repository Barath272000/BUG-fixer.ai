NODE_ENV=development
PORT=4000
# Leave empty for the default proxied setup.
# The app auto-allows localhost and Codespaces forwarding hosts.
CORS_ORIGIN=

DATABASE_URL=postgresql+asyncpg://bugfixai:bugfixai@localhost:5432/bugfixai
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-racp .env.example .envndom-32-plus-character-secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

STORAGE_ROOT=./storage
SANDBOX_WORK_ROOT=./sandbox-work
LIVE_WORKSPACE_ROOT=./live-workspace
PIPELINE_SANDBOX_ROOT=./pipeline-sandbox
PIPELINE_TMPFS_ROOT=/dev/shm/agis-pipeline
# Optional absolute public base URL for pipeline preview proxy links.
PIPELINE_PREVIEW_PUBLIC_URL=
MAX_UPLOAD_BYTES=524288000
SANDBOX_TIMEOUT_MS=300000
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK_MODE=none

GITHUB_API_URL=https://api.github.com
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

ENCRYPTION_KEY=replace-with-a-random-32-plus-character-key
DEV_SKIP_AUTH=true
LOG_LEVEL=info
