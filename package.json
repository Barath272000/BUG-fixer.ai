{
  "name": "bugfixer-ai-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm --prefix frontend run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop": "node scripts/run-desktop-shell.js",
    "desktop:check": "node scripts/run-desktop-shell.js --check",
    "start": "node scripts/run-desktop-shell.js",
    "electron": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^31.7.1",
    "wait-on": "^8.0.1"
  }
}
